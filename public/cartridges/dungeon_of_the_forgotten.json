  "systems": {
    "melee_attack": {
      "listens_for": "ACTION_ATTACK",
      "context": { "attacker": "event.source", "target": "event.target" },
      "requires": [
        "distance(attacker.Position, target.Position) == 1",
        "attacker.Faction.id != target.Faction.id"
      ],
      "priority": 10,
      "effects": [
        {
          "type": "MUTATE",
          "target": "target.Health.current",
          "operation": "SUBTRACT",
          "value": "max(1, attacker.CombatStats.strength - (target.CombatStats.armor || 0))"
        },
        {
          "type": "LOG_MESSAGE",
          "message": "{attacker.Description.name} strikes {target.Description.name} for {value} damage!"
        }
      ],
      "post_checks": [
        {
          "if": "target.Health.current <= 0",
          "then": [
            { "type": "LOG_MESSAGE", "message": "{target.Description.name} was defeated!" },
            { "type": "DESTROY_ENTITY", "target": "target" },
            { "type": "SPAWN_ENTITY", "blueprint": "corpse", "at": "target.Position" }
          ]
        }
      ]
    }
  },
  "world_gen": {
    "width": 38,
    "height": 30,
    "algorithm": "bsp_rooms",
    "room_min_size": 5,
    "room_max_size": 9,
    "wall_glyph": "🧱",
    "floor_glyph": "▫️",
    "wall_density": 0.45,
    "spawn_table": [
      { "blueprint": "goblin", "weight": 0.4, "max_per_level": 5 },
      { "blueprint": "skeleton", "weight": 0.3, "max_per_level": 3 },
      { "blueprint": "orc_guard", "weight": 0.15, "max_per_level": 2 },
      { "blueprint": "broadsword", "weight": 0.25, "max_per_level": 1 },
      { "blueprint": "iron_shield", "weight": 0.25, "max_per_level": 1 },
      { "blueprint": "health_potion", "weight": 0.35, "max_per_level": 3 }
    ]
  },
  "events": [
    "ACTION_MOVE",
    "ACTION_ATTACK",
    "TURN_START",
    "TURN_END"
  ]
}
